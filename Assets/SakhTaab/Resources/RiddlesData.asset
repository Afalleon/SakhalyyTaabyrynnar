  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf8158ad1e002bc4a8e003ab13cd1da8, type: 3}
  m_Name: RiddlesData
  m_EditorClassIdentifier: 
  riddles:
  - riddleText: "\u0410\u04BB\u044B\u044B\u0440 \u0430\u04BB\u044B\u044B\u0440 \u0442\u043E\u043F\u043F\u043E\u0442
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u041E\u04BB\u043E\u0445"
    textDescription: "\u0414\u044C\u0438\u044D\u043D\u0438 \u0441\u044B\u043B\u044B\u0442\u0430\u0440\u0433\u0430,
      \u0430\u0441 \u0430\u0441\u0442\u044B\u044B\u0440\u0433\u0430 \u0430\u043D\u0430\u0430\u043D
      \u043E\u04A5\u043Eh\u0443\u043B\u043B\u0443\u0431\u0443\u0442 \u0431\u0443\u043E\u0440
      (\u0442\u0443\u043E\u0439) \u044D\u0431\u044D\u0442\u044D\u0440 \u043A\u0438\u0440\u043F\u0438\u0438\u0447\u0447\u044D
      \u0442\u0443\u0442\u0443\u0443."
    imageDescription: {fileID: 21300000, guid: 6bfe3d1a78ccaf84fa0a972c1f5a3eab, type: 3}
    levelCompleted: 0
  - riddleText: "\u0425\u0430\u043B\u043B\u0430\u0430\u04A5\u04A5\u0430 \u0442\u0438\u0438\u0439\u044D\u0440
      \u0442\u0443\u043C\u0443\u0441\u0442\u0430\u0430\u0445, \u0438\u043A\u043A\u0438
      \u043A\u04AF\u043A\u04AF\u0440 \u0442\u0430\u0430\u0441 \u043A\u044B\u043D\u0430\u0442\u0442\u0430\u0430\u0445
      \u0431\u0430\u0440\u044B\u043B\u044B\u044B\u0440 \u0431\u0430\u0440 \u04E9\u043A\u0441\u04E9\u043D\u04AF
      \u043A\u044B\u044B\u043B, \u0438\u043B\u0438\u043D \u0434\u0438\u044D\u043A\u0438\u0442\u0442\u044D\u043D
      \u043A\u044D\u043B\u044D\u043D, \u0442\u0443\u043C\u0443\u043B\u0433\u0430
      \u0438\u04A5\u044D\u043D \u0445\u0430\u0430\u043B\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0411\u044B\u0440\u0434\u0430\u0445"
    textDescription: "\u0421\u0438\u043D\u043D\u044C\u0438\u0433\u044D\u0441 \u044D\u0442\u0442\u044D\u044D\u0445,
      \u0430\u0442\u0430\u0445\u0442\u0430\u0430\u0445, \u0442\u0443\u043C\u0443\u0441\u0442\u0430\u0430\u0445,
      \u0445\u0430\u0430\u043D \u0443\u0442\u0430\u0445\u0442\u0430\u0430\u0445 \u04AF\u04E9\u043D-\u043A\u04E9\u0439\u04AF\u04AF\u0440
      \u043A\u04E9\u0442\u04E9 \u0441\u044B\u043B\u0434\u044C\u0430\u0440 \u043A\u04E9\u0440\u04AF\u04A5\u044D."
    imageDescription: {fileID: 21300000, guid: 42ea82dff8ec39445af802b69c170b56, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u04AF\u043D\u0434\u04AF \u043C\u0430\u0441\u0442\u0430\u043D
      \u043A\u04AF\u043D \u0442\u0430\u0445\u0441\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0427\u04AF\u043C\u044D\u0447\u0438"
    textDescription: "\u041F\u0430\u0440\u0430\u0444\u0438\u043D\u0442\u0430\u043D
      (\u0431\u044B\u043B\u044B\u0440 \u043A\u044B\u044B\u043B \u0441\u044B\u0430\u0442\u044B\u0442\u0442\u0430\u043D)
      \u043E\u04A5\u043E\u04BB\u0443\u043B\u043B\u0430\u0440, \u0438\u04BB\u0438\u0433\u044D\u0440
      \u0431\u0438\u0442\u0438\u0438\u043B\u043B\u044D\u044D\u0445, \u0434\u044C\u0438\u044D
      \u0438\u04BB\u0438\u043D \u0441\u044B\u0440\u0434\u0430\u0442\u0430\u0440\u0433\u0430
      \u0430\u043D\u0430\u043B\u043B\u0430\u0430\u0445 \u0443\u04BB\u0443\u043D \u0441\u0438\u043D\u043D\u044C\u0438\u0433\u044D\u0441
      \u043E\u04A5\u043E\u04BB\u0443\u043A (\u0431\u044B\u04BB\u0430 \u0445\u043E\u043B\u043E\u043E\u043D
      \u043E\u0442\u0443\u0447\u0447\u0430 \u0441\u044D\u043D\u0442\u0438\u043C\u0438\u044D\u0442\u0438\u0440
      \u0443\u04BB\u0443\u043D\u043D\u0430\u0430\u0445)."
    imageDescription: {fileID: 21300000, guid: 7cab76841e9435f44a83434796912cc8, type: 3}
    levelCompleted: 0
  - riddleText: "\u0421\u044D\u0442\u0442\u044D \u0443\u043E\u043D \u0445\u0430\u0440\u0430\u0445\u0442\u0430\u0430\u0445
      \u04E9\u043B\u04AF\u04AF \u0441\u0438\u0442\u0438\u043C\u044D \u0443\u0443\u0433\u0430
      \u0443\u043C\u0441\u0443\u0431\u0443\u0442 \u04AF\u04BB\u04AF."
    answer: "\u0418\u043B\u0438\u043C"
    textDescription: "\u041A\u044B\u043B\u0442\u0430\u043D \u044D\u0431\u044D\u0442\u044D\u0440
      \u0445\u043E\u043F\u043F\u0443\u0440\u0443\u043E\u043D\u0442\u0430\u043D \u0442\u044D\u04A5
      \u0445\u0430\u0440\u0430\u0445\u0442\u0430\u0440\u0434\u0430\u0430\u0445 \u0433\u044B\u043D\u0430
      \u0431\u0430\u0430\u0439\u044B\u043B\u043B\u044B\u0431\u044B\u0442 \u0431\u0430\u043B\u044B\u043A\u0442\u044B\u044B\u0440
      \u0442\u044D\u0440\u0438\u043B."
    imageDescription: {fileID: 21300000, guid: 02990f3efc8eb634f838fee7ab914295, type: 3}
    levelCompleted: 0
  - riddleText: "\u0410\u043B\u0434\u044C\u0430\u0440\u0445\u0430\u0439 \u0443\u043E\u043B\u0430
      \u0445\u0430\u0430\u043D\u043D\u0430\u0430\u0445 \u0431\u044D\u0440\u0433\u044D\u04BB\u044D\u043B\u044D\u044D\u0445
      \u04AF\u04BB\u04AF."
    answer: "\u0422\u043E\u04A5\u0441\u043E\u0495\u043E\u0439"
    textDescription: "\u041C\u0430\u0441 \u0443\u043C\u043D\u0430\u04BB\u044B\u0433\u0430\u0440,
      \u043C\u0443\u0442\u0443\u0433\u0430\u0440 \u0441\u044B\u0442\u044B\u044B \u0442\u044B\u04A5\u044B\u0440\u0430\u0445\u0442\u0430\u0440\u044B\u043D\u0430\u043D
      \u0445\u0430\u0442\u044B\u0440\u044B\u043A\u043A\u0430 \u0445\u0430\u0442\u0430\u043D\u0430\u043D,
      \u0443\u04BB\u0443\u043A\u0442\u0430\u0430\u0445 \u043A\u0443\u0442\u0443\u0440\u0443\u043A\u0442\u0430\u0440\u044B\u043D
      \u0445\u043E\u0442\u043E\u0495\u043E\u0439\u0443\u0433\u0430\u0440 \u0442\u0438\u0440\u044D\u043D\u044D\u043D,
      \u04E9\u0440\u04E9 \u044B\u0441\u0442\u0430\u04A5\u0430\u043B\u0430\u0430\u043D
      \u0441\u044B\u0495\u0430\u0440\u044B\u0439\u0430\u0440, \u044D\u0440\u0438\u044D\u043D
      \u044D\u0431\u044D\u0442\u044D\u0440 \u0441\u0430\u0430\u0434\u044C\u0430\u0495\u0430\u0439
      \u0434\u044C\u04AF\u04BB\u04AF\u043D\u043D\u044D\u044D\u0445, \u043E\u0440\u043E\u0439\u0443\u0433\u0430\u0440
      \u043A\u044B\u04BB\u044B\u043B\u043B\u0430\u0430\u0445, \u043C\u0430\u04BB\u044B
      \u0442\u043E\u04A5\u0441\u0443\u0439\u0430\u043D \u04AF\u04E9\u043D\u04AF\u043D\u044D\u043D
      \u0430\u04BB\u044B\u043B\u044B\u043A\u0442\u0430\u043D\u0430\u0440 \u043A\u044B\u0440\u0430
      \u043A\u04E9\u0442\u04E9\u0440."
    imageDescription: {fileID: 21300000, guid: 10b3f9b69960b2443a1516c294efeff1, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u044B\u04BB\u044B\u043D \u043A\u044D\u043B\u043B\u044D\u0495\u0438\u043D\u044D
      \u043A\u044B\u04BB\u0430\u043B\u0495\u0430\u0442\u0430 \u043A\u044B\u0447\u0447\u044B\u044B\u0440
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u042D\u04BB\u044D"
    textDescription: "\u041A\u0443\u0433\u0430\u0441\u0442\u044B\u04A5\u044B \u043A\u04AF\u0440\u044D\u04A5
      \u0442\u04AF\u04AF\u043B\u044D\u044D\u0445 \u0443\u043B\u0430\u0445\u0430\u043D
      \u0430\u0434\u044C\u044B\u0440\u0495\u0430 \u043A\u044B\u044B\u043B."
    imageDescription: {fileID: 21300000, guid: 197e4352e6e900844898e50a5831c302, type: 3}
    levelCompleted: 0
  - riddleText: "\"\u0411\u0430\u0440\u044B\u0430\u04A5 \u2013 \u0431\u0430\u0441\u043A\u0430
      \u0431\u0438\u044D\u0440\u0438\u044D\u043C, \u043A\u044D\u043B\u0438\u044D\u04A5
      \u2013 \u043A\u044D\u0442\u044D\u0445\u0445\u044D \u0431\u0438\u044D\u0440\u0438\u044D\u043C\",
      \u2013 \u0434\u0438\u0438\u0440 \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0421\u043E\u0445\u0441\u043E"
    textDescription: "\u0411\u0443\u043B\u0434\u0443 (\u0445\u043E\u043B., \u043A\u0443\u043E\u0431\u0430\u0495\u044B,
      \u044D\u04BB\u044D\u043D\u0438 \u043E. \u0434. \u0430.) \u0431\u0430\u0442\u0442\u0430\u0442\u0430\u043D
      \u04E9\u043B\u04E9\u0440\u04E9\u0440\u0433\u04E9 \u0430\u043D\u0430\u043B\u043B\u0430\u0430\u0445
      \u043C\u0430\u04BB\u044B\u043D\u0430\u043D \u043E\u04A5\u043E\u04BB\u0443\u043B\u043B\u0443\u0431\u0443\u0442
      \u0431\u0443\u043B\u0442 \u0441\u044D\u0431\u044D."
    imageDescription: {fileID: 21300000, guid: 23759069c60e3d041a61d19a9fe811a1, type: 3}
    levelCompleted: 0
  - riddleText: "\u041C\u0438\u043D \u043E\u043B\u0443\u0441 \u043A\u044B\u0440\u0434\u044C\u0430\u0495\u0430\u0441\u043F\u044B\u043D,
      \u043E\u043B\u0443\u0441 \u044D\u0434\u044D\u0440\u0431\u0438\u043D, \u0445\u0430\u04BB\u0430\u043D
      \u0442\u04E9\u0440\u04E9\u04E9\u0431\u04AF\u043F\u043F\u04AF\u043D \u0431\u0438\u043B\u0431\u044D\u043F\u043F\u0438\u043D,
      \u0445\u0430\u04BB\u0430\u043D \u0434\u0430 \u04E9\u043B\u0431\u04E9\u043F\u043F\u04AF\u043D."
    answer: "\u041E\u043B\u043E\u0445"
    textDescription: "\u0414\u044C\u043E\u043D \u0442\u04E9\u0440\u04E9\u04E9\u043D-\u04AF\u04E9\u0441\u043A\u044D\u044D\u043D,
      \u04AF\u043B\u044D\u043B\u044D\u044D\u043D-\u0445\u0430\u043C\u0441\u0430\u0430\u043D
      \u0441\u044B\u043B\u0434\u044C\u044B\u044B\u043B\u0430\u0440\u0430, \u0441\u044B\u043B\u0434\u044C\u0430\u0440
      \u0443\u0441\u0443\u043B\u0443\u043E\u0431\u0443\u0439\u0430\u043B\u0430\u0440\u0430."
    imageDescription: {fileID: 21300000, guid: b04a743be8df1d34881cd63a3b358b72, type: 3}
    levelCompleted: 0
  - riddleText: "\u0422\u0438\u0438\u0441\u0442\u044D\u044D\u0445 \u0434\u0430, \u044B\u0442\u044B\u0440\u0431\u0430\u0442
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u041A\u044B\u0440\u0430\u0430\u0431\u044B\u043B"
    textDescription: "\u0422\u0438\u0438\u04BB\u0438\u043D\u044D\u043D \u0442\u0430\u0440\u044B\u0439\u0430\u043D
      \u043E\u0442 \u043C\u0443\u043D\u043D\u044C\u0430\u0440, \u0431\u0443\u043E\u0440
      \u043A\u04E9\u0431\u04AF\u0442\u044D\u0440, \u0441\u0438\u0440 \u044B\u0440\u0430\u0430\u0441\u0442\u044B\u044B\u0440
      \u0443\u04BB\u0443\u043D \u0443\u043A\u0442\u0430\u0430\u0445 \u0442\u044D\u0440\u0438\u043B."
    imageDescription: {fileID: 21300000, guid: 2a1da8d0873bf4c42a7c26109b5e46d5, type: 3}
    levelCompleted: 0
  - riddleText: "\u0410\u043B\u0442\u0430\u043D \u0441\u043E\u043B\u0443\u0443\u0440
      \u0438\u04BB\u0438\u0433\u044D\u0440 \u0441\u043E\u0495\u043E\u0442\u043E\u0445
      \u0441\u044B\u043C\u044B\u044B\u0442 \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u041C\u044D\u0439\u0438\u0438"
    textDescription: "\u041A\u0438\u04BB\u0438 \u0442\u04E9\u0431\u04E9\u0442\u04AF\u043D
      \u0438\u04BB\u0438\u043D\u044D\u044D\u0495\u0438 \u04E9\u0439\u0434\u04AF\u04AF\u0440-\u0442\u043E\u043B\u043A\u0443\u0439\u0434\u0443\u0443\u0440
      \u0443\u043E\u0440\u0433\u0430\u043D\u0430."
    imageDescription: {fileID: 21300000, guid: a33b4b97f14309b49bcbbeeb052b75fc, type: 3}
    levelCompleted: 0
  - riddleText: "\u0421\u044B\u0442\u0430\u043D \u044D\u0440\u044D \u043A\u04AF\u04AF\u0441\u0442\u044D\u044D\u0445
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0425\u0430\u0440\u0447\u044B"
    textDescription: "\u04AE\u043F, \u04AF\u043B\u044D \u044D\u0431\u044D\u0442\u044D\u0440
      \u0442\u0443\u043E\u0445 \u044D\u043C\u044D \u0438\u04BB\u0438\u043D \u0442\u04E9\u043B\u04E9\u0431\u04AF\u0440
      \u0431\u0443\u043E\u043B\u0430\u0440 \u0431\u044D\u043B\u0438\u044D."
    imageDescription: {fileID: 21300000, guid: e343672c033a43242bddcfce6d59746d, type: 3}
    levelCompleted: 0
  - riddleText: "\u041C\u0443\u043E\u0440\u0430 \u043E\u0440\u0442\u043E\u0442\u0443\u0433\u0430\u0440
      \u043A\u04E9\u043C\u04AF\u0441 \u043A\u044B\u0442\u0430\u0445 \u0443\u0441\u0442\u0430
      \u0441\u044B\u043B\u0434\u044C\u0430\u0440."
    answer: "\u041A\u04AF\u043D"
    textDescription: "\u0421\u044B\u0440\u0434\u044B\u0433\u044B, \u0438\u0442\u0438\u0438\u043D\u0438
      \u0431\u0438\u044D\u0440\u044D\u043D, \u0441\u0438\u0440\u0433\u044D \u043E\u043B\u043E\u0445
      \u04AF\u04E9\u0441\u043A\u04AF\u04AF\u0440\u04AF\u0433\u044D\u0440 \u0442\u04E9\u0440\u04AF\u0442
      \u0431\u0443\u043E\u043B\u0430\u0440, \u043C\u044D\u043B\u0434\u044C\u0438
      \u0443\u043E\u0442 \u043A\u0443\u0442\u0430\u0430\u043D\u0430\u043D \u0443\u043C\u0430\u0439\u0430\u0440,
      \u0442\u04E9\u0433\u04AF\u0440\u04AF\u043A \u0431\u044B\u04BB\u044B\u044B\u043B\u0430\u0430\u0445
      \u0445\u0430\u043B\u043B\u0430\u0430\u043D \u044D\u0442\u0442\u0438\u0433\u044D."
    imageDescription: {fileID: 21300000, guid: 38a53b242b2fe8f41b1a96e55edf8a9d, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u04AF\u043D \u0430\u043D\u043D\u044B\u0433\u0430\u0440 \u043A\u04AF\u043B\u04AF\u0433\u044D
      \u0434\u0430 \u043A\u04E9\u0441\u0442\u04AF\u0431\u044D\u043A\u043A\u044D \u043A\u04AF\u04AF\u04BB\u04AF\u0440\u0433\u04AF\u04AF\u0440
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0422\u044B\u0430\u043B"
    textDescription: "\u0410\u0439\u044B\u043B\u0495\u0430\u0495\u0430 \u0441\u0430\u043B\u0433\u044B\u043D
      \u0441\u04AF\u04AF\u0440\u044D\u044D\u043D\u044D, \u0445\u0430\u043C\u0441\u0430\u0430\u04BB\u044B\u043D\u0430."
    imageDescription: {fileID: 21300000, guid: 4bc84fa086f939043a44af23960fadd8, type: 3}
    levelCompleted: 0
  - riddleText: "\u0421\u0438\u044D\u043C\u044D\u0442\u044D \u0434\u0430 \u0441\u0443\u043E\u0445
      \u04AF\u04AF\u043D\u044D\u0440."
    answer: "\u0411\u0430\u0442\u0442\u0430\u0445"
    textDescription: "\u041A\u0438\u04BB\u0438 \u043A\u0443\u0439\u0430\u0445\u0430\u0442\u044B\u043D
      \u0441\u0430\u0431\u0430 \u04AF\u04AF\u043D\u044D\u0440, \u043A\u044D\u043C\u0438\u0442\u0442\u044D\u043D
      \u043A\u044D\u043C\u0438\u0433\u044D\u0440 \u043A\u044B\u0440\u0433\u044B\u043B\u043B\u0430\u0440
      \u0442\u04AF\u04AF."
    imageDescription: {fileID: 21300000, guid: c740b23c489e03047a9b4a7cad0dc6ec, type: 3}
    levelCompleted: 0
  - riddleText: "\u0421\u0430\u0439\u044B\u043D \u0441\u0430\u0495\u044B\u043D\u043D\u044C\u0430\u0445
      \u043A\u044D\u0442\u044D\u0440, \u043A\u044B\u04BB\u044B\u043D \u0443\u0441\u0442\u0430\u043D
      \u043A\u044D\u0431\u0438\u04BB\u044D\u0440 \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0422\u044B\u0430"
    textDescription: "\u0425\u043E\u0439\u0443\u0443\u0442\u0443\u043A \u04AF\u04AF\u043C\u043C\u04AF\u0442
      \u043C\u0430\u0441\u0442\u0430\u0430\u0445 \u0441\u0438\u0440, \u043E\u0439\u0443\u0443\u0440."
    imageDescription: {fileID: 21300000, guid: efcf8622d10ecdf418ae2c57e4a4cade, type: 3}
    levelCompleted: 0
  - riddleText: "\u0411\u0443\u0443\u0442 \u0442\u0443\u0443\u0441\u043A\u0430 \u0434\u0430
      \u0431\u0443\u0441\u0442\u0430\u0440, \u0442\u0443\u0443\u04BB\u0430 \u0431\u0438\u043B\u043B\u0438\u0431\u044D\u0442
      \u043C\u0443\u0443\u043D\u0442\u0430 \u044D\u0442 \u0431\u0430\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u0421\u044B\u043C\u044B\u044B\u0442"
    textDescription: "\u041A\u04E9\u0442\u04E9\u0440\u0434\u04E9\u0440 \u0443\u043E\u043D\u043D\u0430
      \u0430\u0442\u044B\u043D \u0445\u0430\u0440\u0430\u043C\u0430\u0439\u0434\u0430\u0440
      \u04AF\u04E9\u0441\u043A\u044D\u0445\u0442\u044D\u0440\u044D \u0431\u0443\u043E\u043B\u0430\u0440,
      \u043D\u044C\u043E\u043B\u0431\u043E\u0495\u043E\u0440\u0434\u0443\u04A5\u0443
      \u0442\u04E9\u0433\u04AF\u0440\u04AF\u043A \u0431\u044B\u04BB\u044B\u044B\u043B\u0430\u0430\u0445
      \u0447\u0430\u0440\u0430\u0430\u0441 \u0445\u0430\u0445 \u0438\u04BB\u0438\u0433\u044D\u0440
      \u0441\u044B\u043B\u0434\u044C\u0430\u0440, \u0431\u0435\u043B\u043E\u043A\u0442\u0430\u0430\u0445
      \u0443\u043E\u04BB\u0430\u0445\u0442\u0430\u043D \u0442\u0443\u0440\u0430\u0440
      \u0441\u044B\u044B\u0439\u044B\u043B\u043B\u0430\u0495\u0430\u0441 \u0443\u0431\u0430\u0495\u0430\u0441."
    imageDescription: {fileID: 21300000, guid: 3c49d4af7b52f8f4fa38d1357d3ae0a9, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u04AF\u043D \u0441\u0438\u0440\u0438\u0433\u044D\u0440 \u0442\u0443\u043E\u0445\u0442\u0430\u043D
      \u0434\u0430 \u043A\u04AF\u043D\u0434\u04AF \u0442\u0443\u043E\u0445 \u0431\u0430\u0430\u0440\u044B\u0439?"
    answer: "\u0418\u0439\u044D"
    textDescription: "\u0422\u04E9\u0440\u04E9\u043F\u043F\u04AF\u0442 \u043E\u0495\u043E\u043B\u043E\u043E\u0445
      \u0434\u044C\u0430\u0445\u0442\u0430\u0440."
    imageDescription: {fileID: 21300000, guid: 463f03326332aac4f82443972d897abd, type: 3}
    levelCompleted: 0
  - riddleText: "\u0423\u0443\u0433\u0430 \u0442\u04E9\u0440\u04E9\u04E9\u0431\u04AF\u0442,
      \u0443\u0443\u0442\u0442\u0430\u043D \u043A\u0443\u0442\u0442\u0430\u043D\u0430\u0440
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0422\u0443\u0443\u0441"
    textDescription: "\u0410\u0441\u043A\u0430 \u043A\u0443\u0442\u0443\u043B\u043B\u0430\u0440
      \u0430\u04BB\u044B\u044B \u0430\u043C\u0442\u0430\u043D\u043D\u0430\u0430\u0445
      \u0431\u044B\u043F-\u0431\u044B\u0442\u0430\u0440\u0445\u0430\u0439 \u04AF\u0440\u04AF\u04A5
      \u04E9\u04A5\u043D\u04E9\u04E9\u0445 \u0442\u0443\u043C\u0430."
    imageDescription: {fileID: 21300000, guid: b30c18dbbee40a14093e46698b76282e, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u04AF\u04A5\u04A5\u044D \u0431\u0438\u0438\u0440\u0434\u044D
      \u043A\u04E9\u0441\u0442\u04E9\u043D \u0430\u0430\u04BB\u0430\u0440 \u0445\u0430\u0440\u0430
      \u0434\u044C\u0430\u0430\u04BB\u044B\u043A \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0422\u04AF\u04AF\u043D"
    textDescription: "\u0421\u0443\u0443\u043A\u043A\u0430 \u0445\u0430\u0440\u0430\u04A5\u0430
      \u043A\u044D\u043C\u044D (\u043A\u0438\u044D\u04BB\u044D\u044D\u04A5\u04A5\u0438
      \u0443\u043E\u043D\u043D\u0430 \u0441\u0430\u0440\u0441\u044B\u0430\u0440\u0434\u0430\u0430\u04A5\u04A5\u044B
      \u043A\u044D\u043C \u0438\u043A\u043A\u0438 \u0430\u0440\u0434\u0430)."
    imageDescription: {fileID: 21300000, guid: aad45535197296844b55b7de661e925c, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u0438\u04BB\u0438 \u0445\u0430\u0440\u0430\u0495\u0430\u0440
      \u043A\u04E9\u0441\u0442\u04AF\u0431\u044D\u0442 \u0434\u0430, \u0430\u0430\u043D
      \u0434\u043E\u0439\u0434\u0443\u043D\u0443 \u0442\u0443\u0442\u0430\u043D \u043E\u043B\u043E\u0440\u043E\u043E\u0447\u0447\u0443
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0421\u0430\u043B\u0433\u044B\u043D"
    textDescription: "\u0422\u044B\u044B\u043D\u0430\u0440 \u0442\u044B\u044B\u043D\u043D\u0430\u0430\u0445
      \u044D\u0495\u0438\u0440\u0438\u0439\u044D\u043D \u0442\u044B\u044B\u043D\u0430\u043D
      \u0442\u0443\u04BB\u0430\u043D\u0430\u0440, \u043A\u0438\u04BB\u0438 \u044D\u0442\u0438\u0433\u044D\u0440
      \u0441\u044B\u043B\u0430\u0430\u04BB\u044B\u043D\u0430\u043D, \u0442\u044B\u043C\u043D\u044B\u044B\u0442\u044B\u043D\u0430\u043D
      \u044D\u0440\u044D \u0443\u043E\u043D\u043D\u0430 \u0442\u044B\u0430\u043B
      \u0431\u0443\u043E\u043B\u0430\u043D \u0431\u0438\u043B\u043B\u044D\u0440 \u0430\u0430\u043D
      \u0434\u043E\u0439\u0434\u0443 \u04AF\u04BB\u04AF\u0441 (\u0441\u0438\u0440\u0438,
      \u0443\u0443\u043D\u0443 \u0441\u044D\u0440\u0433\u044D) \u0443\u0440\u0430\u0442\u044B
      \u044D\u0439\u0433\u044D\u0442\u044D."
    imageDescription: {fileID: 21300000, guid: e990a1ca305fee941a523c8d0800347f, type: 3}
    levelCompleted: 0
  - riddleText: "\u0421\u043E\u043B\u043A\u043E \u043A\u0443\u0440 \u0442\u0430\u04A5\u043D\u0430\u0440\u044B
      \u043D\u0430\u043C\u044B\u043B\u044B\u0439\u0430\u043D \u0442\u0443\u0440\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u041A\u0443\u0441\u0442\u0443\u043A"
    textDescription: "\u0410\u0440\u0434\u0430\u0445 \u043A\u044D\u043D\u043D\u0438\u0442\u0442\u044D\u043D
      \u0445\u0430\u043B\u043B\u0430\u0430\u04A5\u04A5\u0430 \u043A\u04E9\u0441\u0442\u04E9\u0440
      \u0430\u0440\u0430\u0430\u0441 \u04E9\u04A5\u043D\u04E9\u04E9\u0445 \u0434\u0443\u0433\u0430\u043B\u044B\u044B
      \u0431\u044B\u04BB\u044B\u044B\u043B\u0430\u0430\u0445 \u0441\u0443\u0440\u0430\u0430\u04BB\u044B\u043D
      (\u043A\u04AF\u043D \u0441\u0430\u0440\u0434\u0430\u04A5\u0430\u043B\u0430\u0440\u0430
      \u0430\u0440\u0434\u0430\u0445 \u0442\u0430\u043C\u043C\u0430\u0445\u0442\u0430\u0440\u044B\u0442\u0442\u0430\u043D
      \u0442\u044D\u0439\u044D\u0440\u0438\u0442\u0442\u044D\u043D \u04AF\u04E9\u0441\u043A\u04AF\u04AF\u0440)."
    imageDescription: {fileID: 21300000, guid: 429e62339720270409bc5628a5f78b52, type: 3}
    levelCompleted: 0
  - riddleText: "\u04AE\u0440\u04AF\u04A5 \u0441\u0438\u0431\u044D\u043A\u043A\u0438\u043B\u044D\u0440
      \u0442\u04AF\u04AF\u043D \u04AF\u04AF\u043D\u044D\u043B\u043B\u044D\u0440,
      \u0441\u0430\u0440\u0441\u044B\u0430\u0440\u0434\u0430 \u04E9\u043B\u04E9\u043B\u043B\u04E9\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u0421\u0443\u043B\u0443\u0441\u0442\u0430\u0440"
    textDescription: "\u0425\u0430\u0440\u0430\u04A5\u0430\u0495\u0430 \u0441\u044B\u0440\u0434\u044B\u043A
      \u0442\u0443\u043E\u0447\u0443\u043A\u0430 \u0431\u0443\u043E\u043B\u0430\u043D
      \u043A\u04E9\u0441\u0442\u04E9\u0440, \u0430\u0439\u044B\u043B\u0495\u0430\u0442\u044B\u043D\u0430\u043D
      \u041A\u04AF\u043D \u043A\u0443\u0440\u0434\u0443\u043A \u0445\u0430\u043B\u043B\u0430\u0430\u043D
      \u044D\u0442\u0442\u0438\u0433\u044D."
    imageDescription: {fileID: 21300000, guid: 4bb94c1207d99004d87878d2d0860366, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u04AF\u043D \u0430\u0430\u0439\u044B \u0441\u0443\u0443\u043D\u0430\u0440,
      \u043A\u0438\u044D\u0440\u0433\u044D\u043D\u044D\u0440 \u0431\u0430\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u041A\u0443\u043E\u0441\u043A\u0430"
    textDescription: "\u0421\u0438\u044D\u043C\u044D\u0445 \u043C\u0430\u0439\u0433\u044B\u043B\u0430\u0430\u0445
      (\u043A\u0443\u0442\u0443\u0439\u0430\u0445\u0442\u0430\u0440\u044B \u0441\u0438\u0438\u0440)
      \u0434\u044C\u0438\u044D \u043A\u044B\u0440\u0430 \u043A\u044B\u044B\u043B\u0430."
    imageDescription: {fileID: 21300000, guid: a8014a84395ac794da5e659d22a77584, type: 3}
    levelCompleted: 0
  - riddleText: "\u0410\u0430\u043D \u0418\u0439\u044D \u0434\u043E\u0439\u0434\u0443\u043D\u0443
      \u04AF\u04AF\u0442 \u043A\u0443\u0440\u0434\u0443\u043A \u0434\u044C\u04AF\u04BB\u04AF\u043D\u043D\u044D\u044D\u043D,
      \u043A\u04AF\u043B\u04AF\u043A \u043A\u0443\u0440\u0434\u0443\u043A \u044B\u0440\u0431\u0430\u0430\u0445\u044B\u043B\u0430\u0430\u043D
      \u0443\u0442\u0443\u0442\u0430\u0440 \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0422\u0443\u043C\u0430\u043D"
    textDescription: "\u0414\u044C\u044D\u04A5\u043A\u0438\u0440\u044D \u0441\u0443\u043E\u0445
      \u0441\u0430\u043B\u0433\u044B\u043D \u0445\u0430\u043B\u0495\u0430\u04BB\u0430\u0442\u0430;
      \u0442\u0443\u043E\u0445 \u044D\u043C\u044D \u0431\u0443\u0440\u0443\u043E\u0442\u0430,
      \u043A\u04AF\u0434\u044D\u043D\u044D, \u0447\u0430\u0430\u043D\u0430."
    imageDescription: {fileID: 21300000, guid: 4993f5c23daf86643aade560d2910e7c, type: 3}
    levelCompleted: 0
  - riddleText: "\u0410\u0430\u043D \u0434\u043E\u0439\u0434\u0443\u0433\u0430 \u0441\u0430\u0430\u043C\u0430\u0439
      \u043A\u04AF\u04AF\u0441\u0442\u044D\u044D\u0445 \u043A\u0438\u043C\u0438\u0439?"
    answer: "\u041A\u0438\u04BB\u0438"
    textDescription: "\u04E8\u0439\u0434\u04AF\u04AF\u0440-\u0442\u043E\u043B\u043A\u0443\u0439\u0434\u0443\u0443\u0440,
      \u043A\u044D\u043F\u0441\u044D\u0442\u044D\u0440, \u04AF\u043B\u044D\u043B\u0438\u0438\u0440-\u0430\u0439\u0430\u0440
      \u0434\u044C\u043E\u0495\u0443\u0440\u0434\u0430\u0430\u0445, \u0438\u043A\u043A\u0438
      \u0430\u0442\u0430\u0445\u0442\u0430\u0430\u0445, \u0438\u043A\u043A\u0438
      \u0438\u043B\u0438\u0438\u043B\u044D\u044D\u0445 \u0442\u044B\u044B\u043D\u0430\u0440
      \u0442\u044B\u044B\u043D\u043D\u0430\u0430\u0445 (\u044D. \u0430\u0445\u0441.
      \u0434\u044C\u043E\u043D, \u0442\u04AF\u04E9\u043B\u0431\u044D. \u043A\u0438\u04BB\u0438\u043B\u044D\u0440)."
    imageDescription: {fileID: 21300000, guid: 33eb92daf6ee5304887da54cda72146f, type: 3}
    levelCompleted: 0
  - riddleText: "\u0418\u043A\u043A\u0438 \u0431\u044B\u0440\u0430\u0430\u0442\u0442\u044B\u044B
      \u04AF\u0439\u044D\u043B\u044D\u044D\u0445 \u0441\u0430\u0430\u0441\u0442\u0430\u0440\u044B\u0433\u0430\u0440
      \u043A\u04E9\u0440\u0441\u04AF\u0441\u043F\u044D\u0442\u0442\u044D\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0425\u0430\u0440\u0430\u0445"
    textDescription: "\u041A\u0438\u04BB\u0438, \u0442\u044B\u044B\u043D\u0430\u0440
      \u0442\u044B\u044B\u043D\u043D\u0430\u0430\u0445 \u043A\u04E9\u0440\u04E9\u0440
      \u0443\u043E\u0440\u0433\u0430\u043D\u0430 \u0443\u043E\u043D\u043D\u0430 \u043A\u04E9\u0440\u04E9\u0440\u04E9
      \u0442\u04E9\u04BB\u04E9 \u043C\u04E9\u043B\u0442\u04E9\u0495\u04E9, \u0441\u044B\u0442\u044B\u044B\u0442\u0430."
    imageDescription: {fileID: 21300000, guid: 22bfbd741cf37214c9af1bcd209fb733, type: 3}
    levelCompleted: 0
  - riddleText: "\"\u041C\u0438\u0438\u0433\u0438\u043D\u044D \u0441\u0443\u043E\u0445
      \u0445\u0430\u043D\u043D\u0430 \u0434\u0430 \u043E\u043B\u043E\u0440\u0443\u043E\u0445\u0445\u0443\u0442
      \u0441\u0443\u043E\u0495\u0430\", \u2013 \u0434\u0438\u0438\u0440 \u0431\u0430\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u0414\u044C\u0438\u044D"
    textDescription: "\u0414\u044C\u043E\u043D \u043E\u043B\u043E\u0440\u043E\u0440\u0443\u0433\u0430\u0440
      \u044D\u0431\u044D\u0442\u044D\u0440 \u04AF\u043B\u044D\u043B\u0438\u0438\u0440\u0438\u0433\u044D\u0440
      \u0430\u043D\u0430\u043B\u043B\u0430\u0430\u0445 \u0442\u0443\u0442\u0443\u0443."
    imageDescription: {fileID: 21300000, guid: 79165b9e9e7da224393fcf3a6d77eb45, type: 3}
    levelCompleted: 0
  - riddleText: "\u0410\u0442\u0430\u0445\u0442\u0430\u0430\u0445 \u0434\u0430 \u0441\u04AF\u04AF\u0440\u0431\u044D\u0442
      \u0434\u0430, \u0445\u0430\u0430\u043C\u043F\u0430\u0442 \u0434\u0430 \u0431\u0430\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u041E\u043B\u043E\u043F\u043F\u043E\u0441"
    textDescription: "\u041E\u043B\u043E\u0440\u043E\u0440\u0433\u043E \u0430\u043D\u0430\u043B\u043B\u0430\u0430\u0445
      \u04E9\u0439\u04E9\u043D\u04E9\u0440\u04E9 \u0441\u0443\u043E\u0445 \u044D\u0431\u044D\u0442\u044D\u0440
      \u04E9\u0439\u04E9\u043D\u04E9\u0440\u0434\u04E9\u04E9\u0445 \u0434\u044C\u0438\u044D
      \u0442\u044D\u0440\u0438\u043B\u044D."
    imageDescription: {fileID: 21300000, guid: 6d3891b73b12dd94783ed2d8812d7bb8, type: 3}
    levelCompleted: 0
  - riddleText: "\u0422\u0443\u043E\u0445\u0442\u0430\u043D \u0434\u0430 \u0442\u0443\u0442\u0430\u0430\u0495\u0430
      \u0441\u0443\u043E\u0445 \u044B\u0439\u0430\u043D\u0430\u043D \u0442\u0443\u0440\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u042B\u0439"
    textDescription: "\u0422\u04AF\u04AF\u043D \u0441\u044B\u0440\u0434\u0430\u0430\u043D
      \u043A\u04E9\u0441\u0442\u04E9\u0440 \u0445\u0430\u043B\u043B\u0430\u0430\u043D
      \u044D\u0442\u0442\u0438\u0433\u044D."
    imageDescription: {fileID: 21300000, guid: 1083d7073ce41f44bb7db18b869ae04e, type: 3}
    levelCompleted: 0
  - riddleText: "\u041A\u044B\u04BB\u044B\u043D \u0430\u043C\u043F\u0430\u0430\u0440\u0433\u0430,
      \u0441\u0430\u0439\u044B\u043D \u0445\u043E\u0447\u043E\u0495\u043E \u0441\u044B\u043B\u0434\u044C\u0430\u0440
      \u0431\u0430\u0430\u0440 \u04AF\u04BB\u04AF."
    answer: "\u0425\u043E\u0442\u0443\u0443\u0440"
    textDescription: "\u041E\u0440\u0442\u043E\u0442\u0443\u043D\u0430\u043D \u0442\u0443\u0442\u0430\u0430\u0445\u0442\u0430\u0430\u0445
      \u0443\u04BB\u0443\u043D \u0443\u043A\u043A\u0430 \u043E\u043B\u043E\u0440\u0434\u0443\u043B\u043B\u0443\u0431\u0443\u0442
      \u0434\u0443\u0433\u0430\u043B\u044B\u044B \u0431\u044B\u04BB\u044B\u044B\u043B\u0430\u0430\u0445,
      \u0441\u044B\u0442\u044B\u044B \u0431\u0438\u0438\u043B\u044D\u044D\u0445 \u043E\u0442\u0443
      \u043E\u0445\u0441\u043E\u0440\u0433\u043E \u0442\u0443\u0442\u0442\u0443\u043B\u043B\u0430\u0440
      \u0442\u0438\u043C\u0438\u0440 \u0442\u044D\u0440\u0438\u043B."
    imageDescription: {fileID: 21300000, guid: 67239102be9460e40aa2a7b4dce32e78, type: 3}
    levelCompleted: 0
  - riddleText: "\u0422\u0430\u04BB\u0430\u0495\u0430\u04BB\u044B \u0442\u0430\u04BB\u0430\u0440
      \u0434\u0430, \u043A\u04E9\u043B\u04AF\u04E9\u04BB\u044D\u0442\u044D \u0441\u0443\u043E\u0445,
      \u0441\u0438\u043D \u0430\u0439\u0430\u043D\u043D\u044B\u044B\u0440 \u0434\u0430,
      \u0441\u0443\u043E\u043B\u0430 \u0441\u0443\u043E\u0445 \u0431\u0430\u0430\u0440
      \u04AF\u04BB\u04AF."
    answer: "\u041E\u04A5\u043E\u0447\u043E"
    textDescription: "\u04E8\u0440\u04AF\u0441\u043A\u044D \u043C\u0438\u0438\u043D\u0438\u043B\u043B\u044D\u0440
      \u0443\u043B\u0430\u0445\u0430\u043D \u0442\u044B\u044B (\u0438\u043A\u043A\u0438
      \u04E9\u0442\u0442\u04AF\u043D\u044D\u043D \u044D\u0440\u0434\u0438\u0438\u043B\u044D\u044D\u0445,
      \u044D\u0440\u0434\u0438\u0438\u0442\u044D \u0445\u0430\u0441 \u0434\u0430
      \u043A\u044D\u043A\u043A\u044D \u0431\u0443\u043E\u043B\u0443\u043E\u043D \u0441\u04E9\u043F)."
    imageDescription: {fileID: 21300000, guid: 0d3f2fdd348ba2845be6fa6aad01ece5, type: 3}
    levelCompleted: 0
